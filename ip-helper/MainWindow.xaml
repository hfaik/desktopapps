<Window x:Class="IpHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Helper" Height="660" Width="1020" MinHeight="480" MinWidth="760"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="btnPassive" Content="Pasif oku (0 paket)" Padding="10,4" Margin="0,0,6,4" Click="Passive_Click"
                    ToolTip="Yalnızca işletim sisteminin ARP önbelleğini okur, ağa paket göndermez."/>
            <Button x:Name="btnVerify" Content="Bilinenleri doğrula" Padding="10,4" Margin="0,0,6,4" Click="Verify_Click"
                    ToolTip="Bilinen her cihaza tek ARP isteği gönderir."/>
            <Button x:Name="btnFull" Content="Tam tara" Padding="10,4" Margin="0,0,6,4" Click="Full_Click"
                    ToolTip="Alt ağdaki bilinmeyen her adrese tek ARP isteği gönderir (hız sınırlı)."/>
            <Button x:Name="btnStop" Content="Durdur" Padding="10,4" Margin="0,0,16,4" Click="Stop_Click" IsEnabled="False"/>
            <Button x:Name="btnPorts" Content="Seçili cihazın portlarını tara" Padding="10,4" Margin="0,0,6,4" Click="Ports_Click"
                    ToolTip="Yalnızca seçili cihaza, 11 yaygın porta bağlanmayı dener."/>
            <Button x:Name="btnCsv" Content="CSV'ye aktar" Padding="10,4" Margin="0,0,16,4" Click="Csv_Click"/>
            <CheckBox x:Name="chkDns" Content="Hostname çöz (yeni cihaz başına 1 sorgu)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,4"/>
            <CheckBox x:Name="chkPeriodic" Content="Periyodik doğrula, her" VerticalAlignment="Center" Margin="0,0,4,4"
                      Checked="Periodic_Changed" Unchecked="Periodic_Changed"/>
            <TextBox x:Name="txtMinutes" Text="15" Width="36" Margin="0,0,4,4" VerticalContentAlignment="Center" TextAlignment="Center"
                     LostFocus="Periodic_Changed"/>
            <TextBlock Text="dk" VerticalAlignment="Center" Margin="0,0,0,4"/>
        </WrapPanel>

        <GroupBox Grid.Row="1" Header="Ağlar (işaretliler taranır)" Padding="6" Margin="0,0,0,8">
            <ItemsControl x:Name="netList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Supported}" Content="{Binding Label}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <TextBlock Grid.Row="2" x:Name="freeNote" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="#555"
                   Text="Müsait listesi yalnızca &quot;Tam tara&quot; yapılmış ağlar için gösterilir. Yanıt vermeyen adres kesin boş değildir: kapalı cihaz olabilir, DHCP havuzunu kontrol et."/>

        <TabControl Grid.Row="3">
            <TabItem x:Name="tabUsed" Header="Kullanılan">
                <DataGrid x:Name="usedGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpValue" Width="120"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="130"/>
                        <DataGridTextColumn Header="Üretici" Binding="{Binding Vendor}" Width="140"/>
                        <DataGridTextColumn Header="Açık portlar" Binding="{Binding OpenPorts}" Width="170"/>
                        <DataGridTextColumn Header="Ağ" Binding="{Binding Network}" Width="120"/>
                        <DataGridTextColumn Header="Son görülme" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="tabFree" Header="Müsait">
                <DataGrid x:Name="freeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="IpValue" Width="160"/>
                        <DataGridTextColumn Header="Ağ" Binding="{Binding Network}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Günlük">
                <TextBox x:Name="logBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap"/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" x:Name="status" Margin="0,8,0,0" Text="Hazır."/>
    </Grid>
</Window>
